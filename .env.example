# Copy to backend/.env and adjust. Safe placeholders only - never commit real values.
# All variables are optional; the defaults work for local development.

# Database (SQLite file under backend/data/ by default). PostgreSQL path: see docs/architecture/OVERVIEW.md
# NOVA_DATABASE_URL=sqlite:///./data/nova.db

# Optional shared secret. If set, the API requires "Authorization: Bearer <token>" (health is exempt).
# Set this whenever the backend is reachable by anything other than your own machine.
# NOVA_API_TOKEN=replace-with-a-long-random-string

# Comma separated directories under which repositories may be registered. Empty = any existing directory.
# NOVA_REGISTRATION_BASE_DIRS=C:\Projects,D:\Work

# Comma separated browser origins allowed by CORS (the Vite dev server by default).
# NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Indexing limits
# NOVA_INDEX_MAX_FILES=20000
# NOVA_INDEX_MAX_DEPTH=12
# NOVA_INDEX_MAX_FILE_BYTES=1000000
# NOVA_INDEX_MAX_TOTAL_BYTES=200000000
# NOVA_INDEX_TIME_BUDGET_SECONDS=300
# NOVA_INDEX_MAX_SYMBOLS_PER_FILE=5000
# NOVA_INDEX_MAX_DIAGNOSTICS=500
# Extra gitignore-style patterns to exclude (comma separated), applied in addition to .gitignore
# NOVA_INDEX_EXTRA_EXCLUDES=generated/,*.min.js

# Logging
# NOVA_LOG_LEVEL=INFO
# NOVA_LOG_JSON=true

# AI-assisted repair proposals (opt-in). "none" keeps everything deterministic and nothing leaves the machine.
# "anthropic" lets users ask Claude for a draft patch; the Anthropic SDK reads ANTHROPIC_API_KEY (never put it in a NOVA_ variable).
# Proposals are validated, need human approval and test verification. See docs/architecture/AI_ASSISTED_REPAIR.md.
# NOVA_AI_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-...
# NOVA_AI_MODEL=claude-opus-5-5
# NOVA_AI_EFFORT=high

# ---------------------------------------------------------------------------------------------------------------------
# PRODUCTION (Phase 17). Full reference: docs/operations/PRODUCTION_CONFIGURATION.md. `python -m app.release check-config` validates these.
# In production the API REFUSES TO START if any of the following is wrong:
#   NOVA_ENVIRONMENT=production
#   NOVA_API_TOKEN=<48+ random characters; placeholders such as "replace-me" are rejected>
#   NOVA_INTEGRATION_SECRET_KEY=<urlsafe-base64, 32 bytes; optional, but credentials/webhook secrets are unavailable without it>
#   NOVA_INTEGRATION_ALLOW_PRIVATE_DESTINATIONS=false   (SSRF guard must stay on)
#   NOVA_CORS_ORIGINS=https://your-origin               (no "*")
#   NOVA_OPS_METRICS_PUBLIC=false
# and when the database schema is not at the migration head (run `python -m app.release deploy` first).
# NOVA_REQUIRE_CURRENT_SCHEMA=false     # true enforces the schema check outside production too
# NOVA_DOCS_ENABLED=true                # Swagger/OpenAPI are always off in production
# NOVA_RELEASE_STATE_DIR=               # where deployments.jsonl is written (default backend/data/release-state)
# NOVA_SOURCE_REVISION=                 # commit id recorded in backups and release manifests

# Release 0.19.0
# NOVA_TEST_EXECUTION_ENABLED=true      # false disables every feature that runs repository code (test runs, reruns, repair/refactor verification)
# NOVA_AUTH_FAILURE_LIMIT=20            # invalid bearer tokens per client per window before HTTP 429; 0 disables
# NOVA_AUTH_FAILURE_WINDOW_SECONDS=300
# NOVA_BACKUP_DIR=                      # process environment only (not read from .env), like NOVA_RELEASE_STATE_DIR: default backup dir of `python -m app.release`
