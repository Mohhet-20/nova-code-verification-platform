# Copy to deployment/production.env (git-ignored) and replace every <...> value. Placeholders only - never commit real values.
# Full reference: docs/operations/PRODUCTION_CONFIGURATION.md. Validate with:
#   docker compose -f deployment/docker-compose.yml --env-file deployment/production.env run --rm --no-deps migrate python -m app.release check-config

# ---- required ----
NOVA_ENVIRONMENT=production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NOVA_API_TOKEN=<generate: 48+ random characters>
# Browser origin(s) that load the UI, exactly as typed in the address bar (scheme + host [+ port]); no "*".
NOVA_CORS_ORIGINS=https://nova.your-domain.example
# Host directory holding the repositories NOVA may analyse; mounted at /srv/repos in the API container. Files must be owned by uid 10001.
NOVA_REPOS_HOST_DIR=/srv/nova/repos
NOVA_REGISTRATION_BASE_DIRS=/srv/repos

# ---- recommended ----
# Encrypts stored integration credentials. Generate: python -m app.services.integrations.secrets generate-key  (store it OUTSIDE the backups)
NOVA_INTEGRATION_SECRET_KEY=<generate: urlsafe-base64 of 32 random bytes>
# Commit or release id recorded in backups, the deployment history and the image label.
NOVA_SOURCE_REVISION=<git commit sha or release tag>
# Running approved repository tests executes repository code as the API user (not a sandbox). Set false unless every registered repository is trusted.
NOVA_TEST_EXECUTION_ENABLED=false

# ---- optional ----
# AI-assisted repair proposals from Claude (repository excerpts, secrets scrubbed, are sent to Anthropic when a user asks for one):
# NOVA_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<from the Anthropic Console; read by the Anthropic SDK, not by NOVA settings>
# NOVA_DOMAIN=nova.your-domain.example        # required only with deployment/docker-compose.tls.yml
# NOVA_WEB_BIND=127.0.0.1                     # interface for the web container's port; keep 127.0.0.1 behind a proxy
# NOVA_WEB_PORT=8080
# NOVA_IMAGE_TAG=local
# NOVA_AUTH_FAILURE_LIMIT=20                  # invalid-token attempts per client per window before 429; 0 disables
# NOVA_AUTH_FAILURE_WINDOW_SECONDS=300
# NOVA_LOG_LEVEL=INFO
